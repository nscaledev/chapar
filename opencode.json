{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": {
      "*": "allow"
    },
    "todowrite": "allow",
    "external_directory": "allow",
    "edit": {
      "*": "allow",
      "spack/**": "deny",
      ".spack-env/**": "deny",
      "**/.spack-env/**": "deny",
      ".git/**": "deny",
      "*.lock": "deny",
      "**/*.lock": "deny"
    },
    "bash": {
      "*": "deny",
      "./validation/run list*": "allow",
      "./validation/run --release-dir * list*": "allow",
      "CHAPAR_DRY_RUN=1 ./validation/run*": "allow",
      "CHAPAR_DRY_RUN=1 bash validation/run*": "allow",
      "bash -n *": "allow",
      "bash ci/push-buildcache.sh*": "allow",
      "bash ci/tests/software-specs-offline-gate.sh*": "allow",
      "bash ci/tests/software-specs-python-quality-test.sh*": "allow",
      "bash envs/software/release.sh plan*": "allow",
      "bash envs/software/release.sh status*": "allow",
      "bash envs/software/tests/release-helper-plan-test.sh*": "allow",
      "bash etc/link-scopes.sh*": "allow",
      "bash etc/tests/site-env-test.sh*": "allow",
      "bash validation/run --release-dir * list*": "allow",
      "bash validation/run list*": "allow",
      "ci/push-buildcache.sh*": "allow",
      "code --diff *": "allow",
      "code -d *": "allow",
      "envs/software/release.sh plan*": "allow",
      "envs/software/release.sh status*": "allow",
      "etc/link-scopes.sh*": "allow",
      "gh auth status*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh pr checks*": "allow",
      "gh pr create*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh repo view*": "allow",
      "gh run download*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh run watch*": "allow",
      "gh workflow list*": "allow",
      "gh workflow run*": "allow",
      "gh workflow view*": "allow",
      "git *": "allow",
      "make lint*": "allow",
      "make test*": "allow",
      "node .agents/skills/brave-search/content.js*": "allow",
      "node .agents/skills/brave-search/search.js*": "allow",
      "nohup python .agents/skills/skill-creator/eval-viewer/generate_review.py*": "allow",
      "nohup python3 .agents/skills/skill-creator/eval-viewer/generate_review.py*": "allow",
      "npm install*": "allow",
      "open /tmp/eval_review_*": "allow",
      "python -m scripts.*": "allow",
      "python .agents/skills/skill-creator/eval-viewer/generate_review.py*": "allow",
      "python .agents/skills/skill-creator/scripts/quick_validate.py*": "allow",
      "python3 -m chapar catalog *": "allow",
      "python3 -m chapar image preflight*": "allow",
      "python3 -m chapar image resolve*": "allow",
      "python3 -m chapar image verify-release*": "allow",
      "python3 -m chapar target *": "allow",
      "python3 -m chapar validate *": "allow",
      "python3 -m json.tool ci/cve-checker-config.json*": "allow",
      "python3 -m scripts.*": "allow",
      "python3 .agents/skills/skill-creator/eval-viewer/generate_review.py*": "allow",
      "python3 .agents/skills/skill-creator/scripts/quick_validate.py*": "allow",
      "python3 ci/tests/no-direct-install-surface-test.py*": "allow",
      "source ./etc/init.sh*": "allow",
      "spack --version*": "allow",
      "spack -e envs/* concretize*": "allow",
      "spack -e envs/* config *": "allow",
      "spack -e envs/* find*": "allow",
      "spack -e envs/* module *": "allow",
      "spack -e envs/* spec *": "allow",
      "spack arch*": "allow",
      "spack buildcache *": "allow",
      "spack config *": "allow",
      "spack find*": "allow",
      "spack mirror *": "allow",
      "spack spec *": "allow",
      "uv run --group dev pytest*": "allow",
      "uv run --group dev ruff check*": "allow",
      "uv run --group dev basedpyright*": "allow",
      "uv run chapar --help*": "allow",
      "uv run chapar --version*": "allow",
      "uv run chapar catalog *": "allow",
      "uv run chapar cve scan --release-dir * --plan": "allow",
      "uv run chapar image preflight*": "allow",
      "uv run chapar image resolve*": "allow",
      "uv run chapar image verify-release*": "allow",
      "uv run chapar target *": "allow",
      "uv run chapar validate *": "allow"
    },
    "task": {
      "explore": "allow",
      "general": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow"
  }
}
