# Chapar per-machine site settings.
#
# Copy this file to etc/chapar-site.env and edit it for the cluster or
# workstation where Chapar runs. The live file is ignored by Git; point
# CHAPAR_SITE_CONFIG at another location to keep it outside the checkout
# (for example /etc/chapar/site.env installed by etc/install-site-settings.sh).
#
# Every assignment below uses the `: "${VAR:=value}"` idiom so a variable the
# caller has already exported wins over the site file, and the site file wins
# over the built-in defaults in etc/chapar-defaults.sh. Plain assignments are
# fine for values the site wants to force.

# ---------------------------------------------------------------------------
# Identity: what to build. Both are deliberate choices, never probed from the
# running machine. CHAPAR_TARGET must be a key of containers/images/targets.json
# (for example linux-x86_64-v4 or linux-aarch64-generic) and is required for
# builds, image operations, and validation; an interactive shell may leave it
# unset until needed.
: "${CHAPAR_SOFTWARE_SET:=all}"        # vlad | hpcsim | all
: "${CHAPAR_TARGET:=}"

# ---------------------------------------------------------------------------
# Roots. home: private per-user tree under CHAPAR_HOME_ROOT.
#        public: shared tree under CHAPAR_PUBLIC_ROOT (set both).
: "${CHAPAR_INSTALL_MODE:=home}"       # home | public
: "${CHAPAR_HOME_ROOT:=${HOME}/.spack/chapar}"
: "${CHAPAR_PUBLIC_ROOT:=}"            # e.g. /shared/chapar on a cluster

# Derived layout (each individually overridable). CHAPAR_ENV_ROOT is
# CHAPAR_HOME_ROOT or CHAPAR_PUBLIC_ROOT according to CHAPAR_INSTALL_MODE.
#   CHAPAR_INSTALL_TREE_ROOT   shared padded Spack store (arch in projection)
#   CHAPAR_RELEASE_ROOT        immutable releases: <set>/<target>/<id>
#   CHAPAR_MODULE_ROOT         published module trees: <set>/<target>/<id>|current
#   CHAPAR_BUILDCACHE_ROOT     writable binary cache, namespaced per target
#   CHAPAR_CCACHE_ROOT         shared compiler cache, namespaced per target
#   CHAPAR_BUILD_STAGE_ROOT    scratch build stage (node-local is best)
#   CHAPAR_CONTAINER_OUTPUT_ROOT  exported .sqsh images and receipts
#   CHAPAR_VALIDATION_ROOT     validation results
# : "${CHAPAR_INSTALL_TREE_ROOT:=}"
# : "${CHAPAR_RELEASE_ROOT:=}"
# : "${CHAPAR_MODULE_ROOT:=}"
# : "${CHAPAR_BUILDCACHE_ROOT:=}"
# : "${CHAPAR_CCACHE_ROOT:=}"
# : "${CHAPAR_BUILD_STAGE_ROOT:=}"
# : "${CHAPAR_CONTAINER_OUTPUT_ROOT:=}"
# : "${CHAPAR_VALIDATION_ROOT:=}"

# Optional space-separated read-only seed buildcaches consulted before building.
: "${CHAPAR_SEED_MIRRORS:=}"

# Optional shared group and directory mode for public roots.
: "${CHAPAR_SHARED_GROUP:=}"
: "${CHAPAR_SHARED_DIR_MODE:=2775}"

# ---------------------------------------------------------------------------
# Policy.
: "${CHAPAR_MODULE_SYSTEMS:=tcl}"      # "tcl" or "tcl lmod"
: "${CHAPAR_CCACHE_COMPILERCHECK:=content}"
: "${CHAPAR_CCACHE_MAXSIZE:=}"

# Publishing defaults for manual use; CI overrides these explicitly.
: "${PUBLISH_BUILDCACHE:=false}"
: "${PUBLISH_CURRENT:=false}"
: "${PUBLISH_MODULES:=false}"

# ---------------------------------------------------------------------------
# Per-target delivery and Slurm placement. Optional; if the function is not
# declared, every tuple defaults to CHAPAR_DELIVER="modules" and empty Slurm
# placement. etc/chapar-defaults.sh calls this after CHAPAR_SOFTWARE_SET and
# CHAPAR_TARGET are final.
#
#   CHAPAR_DELIVER          word list: modules, container. Gates
#                           release.sh publish-modules and chapar image build;
#                           one release may enable both.
#   CHAPAR_CONTAINER_BASE   key of containers/images/containers.json, required
#                           when CHAPAR_DELIVER contains "container".
#   CHAPAR_SLURM_*          placement for build/validation submission.
#
# chapar_site_target_policy() {
#     case "${CHAPAR_SOFTWARE_SET}:${CHAPAR_TARGET}" in
#         vlad:linux-aarch64-gb300)
#             CHAPAR_DELIVER="modules container"
#             CHAPAR_CONTAINER_BASE=nvidia-vlad
#             CHAPAR_SLURM_PARTITION=gb300
#             CHAPAR_SLURM_CONSTRAINT=gb300
#             ;;
#         hpcsim:*)
#             CHAPAR_DELIVER="modules"
#             CHAPAR_SLURM_PARTITION=cpu
#             ;;
#         *)
#             CHAPAR_DELIVER="modules"
#             ;;
#     esac
#     CHAPAR_SLURM_ACCOUNT=hpc
#     CHAPAR_SLURM_QOS=normal
# }
