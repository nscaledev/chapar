{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nscaledev.github.io/chapar/schemas/target-contract/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "datacenter_id", "status", "target", "allowed_software_sets", "container_selections", "paths", "slurm", "roles", "sharing", "publication", "provenance"],
  "properties": {
    "schema": {"const": "https://nscaledev.github.io/chapar/schemas/target-contract/v1"},
    "schema_version": {"const": 1},
    "datacenter_id": {"$ref": "#/$defs/id"},
    "status": {"const": "example"},
    "target": {"$ref": "#/$defs/target_id"},
    "allowed_software_sets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["vlad", "hpcsim", "all"]}
    },
    "container_selections": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["software_set", "container"],
        "properties": {
          "software_set": {"enum": ["vlad", "hpcsim", "all"]},
          "container": {"$ref": "#/$defs/id"}
        }
      }
    },
    "paths": {
      "type": "object", "additionalProperties": false,
      "required": ["durable_writable", "read_only_inputs", "temporary"],
      "properties": {
        "durable_writable": {
          "type": "object", "additionalProperties": false,
          "required": ["install_tree", "releases", "modulefiles", "writable_buildcache", "ccache", "container_outputs", "receipts", "evidence"],
          "properties": {
            "install_tree": {"$ref": "#/$defs/path"},
            "releases": {"$ref": "#/$defs/path"},
            "modulefiles": {"$ref": "#/$defs/path"},
            "writable_buildcache": {"$ref": "#/$defs/path"},
            "ccache": {"$ref": "#/$defs/path"},
            "container_outputs": {"$ref": "#/$defs/path"},
            "receipts": {"$ref": "#/$defs/path"},
            "evidence": {"$ref": "#/$defs/path"}
          }
        },
        "read_only_inputs": {
          "type": "array", "minItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "path"],
            "properties": {
              "kind": {"enum": ["software_catalog", "target_registry", "container_registry", "sources_lock", "seed_mirror"]},
              "path": {"$ref": "#/$defs/path"}
            }
          }
        },
        "temporary": {
          "type": "object", "additionalProperties": false,
          "required": ["release_staging", "spack_build_stage", "image_staging", "validation_work", "resolver_work"],
          "properties": {
            "release_staging": {"$ref": "#/$defs/path"},
            "spack_build_stage": {"$ref": "#/$defs/path"},
            "image_staging": {"$ref": "#/$defs/path"},
            "validation_work": {"$ref": "#/$defs/path"},
            "resolver_work": {"$ref": "#/$defs/path"}
          }
        }
      }
    },
    "slurm": {"$ref": "#/$defs/placement"},
    "roles": {"$ref": "#/$defs/roles"},
    "sharing": {"$ref": "#/$defs/sharing"},
    "publication": {"$ref": "#/$defs/publication"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "allOf": [
    {
      "$comment": "A contract that selects a container must build inside the reserved /opt/chapar namespace: container injection copies each store prefix into the image at its identical absolute path, so the store root is both a builder path and an in-image path. Enforced identically by tools/chapar_config/paths.py CONTAINER_PREFIX and envs/software/release.sh.",
      "if": {
        "properties": {"container_selections": {"type": "array", "minItems": 1}},
        "required": ["container_selections"]
      },
      "then": {
        "properties": {
          "paths": {
            "properties": {
              "durable_writable": {
                "properties": {
                  "install_tree": {"pattern": "^/opt/chapar(/|$)"}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "target_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "path": {"type": "string", "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?i:replace[_-]|placeholder|change[_-]?me))[^\\u0000]+$"},
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": ["partition", "constraint", "account", "qos"],
      "properties": {
        "partition": {"type": "string", "minLength": 1},
        "constraint": {"type": "string", "minLength": 1},
        "account": {"type": "string", "minLength": 1},
        "qos": {"type": "string", "minLength": 1}
      }
    },
    "roles": {
      "type": "object", "additionalProperties": false,
      "required": ["builder", "validator", "publisher"],
      "properties": {
        "builder": {"type": "string", "minLength": 1},
        "validator": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1}
      }
    },
    "sharing": {
      "type": "object", "additionalProperties": false,
      "required": ["shared_path_classes", "share_across_targets", "share_across_software_sets", "seed_mirrors_read_only"],
      "properties": {
        "shared_path_classes": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["install_tree", "writable_buildcache", "ccache"]}
        },
        "share_across_targets": {"type": "boolean"},
        "share_across_software_sets": {"type": "boolean"},
        "seed_mirrors_read_only": {"const": true}
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["publish_buildcache", "publish_modules", "publish_containers", "promote_current"],
      "properties": {
        "publish_buildcache": {"type": "boolean"},
        "publish_modules": {"type": "boolean"},
        "publish_containers": {"type": "boolean"},
        "promote_current": {"type": "boolean"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["template", "context_sha256", "tool", "authority_sha256"],
      "properties": {
        "template": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version", "sha256"],
          "properties": {
            "name": {"const": "chapar-datacenter"},
            "version": {"pattern": "^1\\.[0-9]+\\.[0-9]+$"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "context_sha256": {"$ref": "#/$defs/sha256"},
        "tool": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version", "sha256", "dependencies"],
          "properties": {
            "name": {"const": "chapar_datacenter_template"},
            "version": {"pattern": "^1\\.[0-9]+\\.[0-9]+$"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "dependencies": {
              "type": "object",
              "additionalProperties": {"type": "string", "minLength": 1},
              "required": ["cookiecutter", "jsonschema", "pydantic", "PyYAML"]
            }
          }
        },
        "authority_sha256": {
          "type": "object", "additionalProperties": false,
          "required": ["container_registry", "datacenter_schema", "target_contract_schema", "target_registry"],
          "properties": {
            "container_registry": {"$ref": "#/$defs/sha256"},
            "datacenter_schema": {"$ref": "#/$defs/sha256"},
            "target_contract_schema": {"$ref": "#/$defs/sha256"},
            "target_registry": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
