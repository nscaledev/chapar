{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nscaledev.github.io/chapar/schemas/vlad-image-site-contract/v1",
  "title": "Vlad HPL image site contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "roles",
    "targets"
  ],
  "properties": {
    "schema": {
      "const": "https://nscaledev.github.io/chapar/schemas/vlad-image-site-contract/v1"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "example",
        "active"
      ]
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builders",
        "publishers",
        "validators"
      ],
      "properties": {
        "builders": {
          "$ref": "#/$defs/machine_id_allowlist"
        },
        "publishers": {
          "$ref": "#/$defs/machine_id_allowlist"
        },
        "validators": {
          "$ref": "#/$defs/machine_id_allowlist"
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linux-x86_64-generic",
        "linux-x86_64-v4",
        "linux-aarch64-gb300"
      ],
      "properties": {
        "linux-x86_64-generic": {
          "allOf": [
            {
              "$ref": "#/$defs/target_contract"
            },
            {
              "properties": {
                "hardware_class": {
                  "const": "physical-x86-64-v1"
                }
              }
            }
          ]
        },
        "linux-x86_64-v4": {
          "allOf": [
            {
              "$ref": "#/$defs/target_contract"
            },
            {
              "properties": {
                "hardware_class": {
                  "const": "physical-x86-64-v4"
                }
              }
            }
          ]
        },
        "linux-aarch64-gb300": {
          "allOf": [
            {
              "$ref": "#/$defs/target_contract"
            },
            {
              "properties": {
                "hardware_class": {
                  "const": "gb300"
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "machine_id_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "target_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware_class",
        "partition",
        "constraint"
      ],
      "properties": {
        "hardware_class": {
          "type": "string"
        },
        "partition": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "constraint": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.&|!()+:-]{0,127}$"
        }
      }
    }
  }
}
