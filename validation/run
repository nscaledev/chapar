#!/usr/bin/env bash
set -euo pipefail

VALIDATION_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
selection=""
contract=""
selection_digest=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --selection) selection="${2:-}"; shift 2 ;;
    --selection-digest) selection_digest="${2:-}"; shift 2 ;;
    --contract) contract="${2:-}"; shift 2 ;;
    --*) echo "Unknown option: $1" >&2; exit 2 ;;
    *) break ;;
  esac
done
cmd="${1:-help}"

if [ -n "${ENV_NAME:-}" ]; then
  echo "ERROR: ENV_NAME is obsolete; pass --selection and --contract" >&2
  exit 2
fi

require_selection() {
  if [ -z "$selection" ] || [ -z "$selection_digest" ] || [ -z "$contract" ]; then
    echo "ERROR: --selection, --selection-digest, and --contract are required" >&2
    exit 2
  fi
}

render_plan() {
  python3 "$VALIDATION_DIR/selection.py" plan \
    --selection "$selection" --selection-digest "$selection_digest" --contract "$contract" --test "$1"
}

submit_test() {
  local name="$1"
  local test_file="$VALIDATION_DIR/tests/${name}.sbatch"
  local placement
  local sealed
  sealed="$(mktemp -d "${TMPDIR:-/tmp}/chapar-validation.XXXXXX")"
  chmod 0700 "$sealed"
  trap 'rm -rf -- "${sealed:-}"' RETURN
  placement="$(python3 "$VALIDATION_DIR/selection.py" shell --selection "$selection" --selection-digest "$selection_digest" --contract "$contract" --test "$name" --seal-dir "$sealed")"
  local sealed_selection="$sealed/selection.json"
  local sealed_contract="$sealed/contract.json"
  local results_root partition constraint account qos
  IFS=$'\t' read -r _ _ _ _ results_root partition constraint account qos <<< "$placement"
  # container-smoke needs one input the selection cannot carry: the sealed .sqsh
  # and its digest. Passed through only when the operator set them; the test
  # verifies the path lies inside the selection's own container_outputs root and
  # SKIPs when they are absent, so this grants no ambient path authority.
  local image_exports=""
  if [ -n "${CHAPAR_CONTAINER_IMAGE:-}" ] && [ -n "${CHAPAR_CONTAINER_IMAGE_SHA256:-}" ]; then
    image_exports=",CHAPAR_CONTAINER_IMAGE=$CHAPAR_CONTAINER_IMAGE,CHAPAR_CONTAINER_IMAGE_SHA256=$CHAPAR_CONTAINER_IMAGE_SHA256"
  fi
  if [ -n "${SLURM_JOB_ID:-}" ]; then
    CHAPAR_SELECTION="$sealed_selection" CHAPAR_SELECTION_DIGEST="$selection_digest" CHAPAR_TARGET_CONTRACT="$sealed_contract" RESULTS_ROOT="$results_root" bash "$test_file"
  else
    sbatch --wait --partition "$partition" --constraint "$constraint" --account "$account" --qos "$qos" \
      --export="CHAPAR_SELECTION=$sealed_selection,CHAPAR_SELECTION_DIGEST=$selection_digest,CHAPAR_TARGET_CONTRACT=$sealed_contract,RESULTS_ROOT=$results_root${image_exports}" "$test_file"
  fi
}

case "$cmd" in
  list)
    echo "Available validation tests:"
    echo ""
    for f in "$VALIDATION_DIR/tests/"*.sbatch; do
      name=$(basename "$f" .sbatch)
      desc=$(sed -n 's/^# DESCRIPTION: //p' "$f" 2>/dev/null || echo "no description")
      printf "  %-20s  %s\n" "$name" "$desc"
    done
    ;;
  all)
    require_selection
    # Exit code 77 means SKIP (test requirements not met on this node);
    # it is reported but does not fail the run.
    failed=0
    for f in "$VALIDATION_DIR/tests/"*.sbatch; do
      name=$(basename "$f" .sbatch)
      printf "\n=== %s ===\n" "$name"
      if [ "${CHAPAR_DRY_RUN:-0}" = "1" ]; then
        render_plan "$name"
        continue
      fi
      rc=0
      submit_test "$name" || rc=$?
      if [ "$rc" = "77" ]; then
        echo "SKIP: $name (requirements not met on this node)" >&2
      elif [ "$rc" != "0" ]; then
        echo "FAIL: $name" >&2
        failed=1
      fi
    done
    [ "$failed" = "0" ] || exit 1
    ;;
  help|--help|-h)
    echo "Usage: ./validation/run <test>"
    echo "       ./validation/run --selection <selection.json> --selection-digest <sha256> --contract <contract.json> <test>"
    echo "       ./validation/run list"
    echo "       ./validation/run all"
    echo ""
    echo "Environment variables:"
    echo "  CHAPAR_NODES           Override node count for multi-node tests"
    echo "  CHAPAR_TIME            Override time limit"
    echo "  CHAPAR_KEEP_MODULES=1  Skip module purge (use pre-loaded environment)"
    echo "  CHAPAR_DRY_RUN=1       Print what would run without executing"
    echo "  RESULTS_ROOT           Custom results directory (default: validation/results/)"
    echo ""
    echo "Exit codes: 0 = pass, 77 = skipped (requirements not met), other = fail"
    echo "  MPI_RDMA_BYTES         Message size for MPI RDMA tests (default: 8388608)"
    echo "  MPI_RDMA_ITERS         Iterations for MPI RDMA tests (default: 100)"
    ;;
  *)
    require_selection
    test_file="$VALIDATION_DIR/tests/${cmd}.sbatch"
    if [ ! -f "$test_file" ]; then
      echo "Unknown test: $cmd" >&2
      echo "Run './validation/run list' to see available tests." >&2
      exit 2
    fi
    if [ "${CHAPAR_DRY_RUN:-0}" = "1" ]; then
      render_plan "$cmd"
      exit 0
    fi
    submit_test "$cmd"
    ;;
esac
